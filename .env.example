NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admissions AI assistant (server-only; never prefix with NEXT_PUBLIC_).
# Chat model provider: deepseek | openai | gemini | mock. Only the selected providers' keys are required.
LLM_PROVIDER=deepseek
# Optional: model id. Defaults: deepseek-flash, gpt-6-luna, gemini-flash-lite-latest.
LLM_MODEL=
# Optional: provider (and model) used when the primary fails before streaming any text.
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=800
# Attempts per provider before failing or falling back (2 = one retry).
LLM_MAX_ATTEMPTS=2
# Reasoning is off for RAG answers; change only to experiment.
DEEPSEEK_THINKING=disabled
OPENAI_REASONING_EFFORT=none
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Set to "off" to silence the per-answer usage logs.
LLM_USAGE_LOG=

# Optional: enables the shared answer cache and rate limits (server-only, never NEXT_PUBLIC_).
# Find it in Supabase > Project Settings > API. Run the latest supabase/schema.sql first.
SUPABASE_SERVICE_ROLE_KEY=
# Site-wide cap on model calls per day (default 400).
ADMISSIONS_DAILY_LIMIT=400
# Site-wide estimated model spend per day in CNY (default 5); after that only rules and cached answers.
ADMISSIONS_DAILY_BUDGET_CNY=5
# Set to "false" to stop all model calls (rules, cached answers, and calculators keep working).
ADMISSIONS_AI_ENABLED=true
# Random secret for signing answers used as follow-up context, e.g. `openssl rand -base64 32`.
ADMISSIONS_HISTORY_SECRET=
