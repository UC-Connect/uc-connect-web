NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admissions AI assistant (server-only; never prefix with NEXT_PUBLIC_).
# Chat model provider: gemini | mock. Only the selected providers' keys are required.
LLM_PROVIDER=gemini
# Optional: model id; defaults to the provider's default (gemini-flash-lite-latest).
LLM_MODEL=
# Optional: provider to use when the primary keeps failing.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=800
GEMINI_API_KEY=

# Optional: enables the shared answer cache and rate limits (server-only, never NEXT_PUBLIC_).
# Find it in Supabase > Project Settings > API. Run the latest supabase/schema.sql first.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: site-wide cap on model calls per day (default 400) to protect the free Gemini quota.
ADMISSIONS_DAILY_LIMIT=400
