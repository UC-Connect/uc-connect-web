NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admissions AI assistant (server-only; never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: enables the shared answer cache and rate limits (server-only, never NEXT_PUBLIC_).
# Find it in Supabase > Project Settings > API. Run the latest supabase/schema.sql first.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: site-wide cap on model calls per day (default 400) to protect the free Gemini quota.
ADMISSIONS_DAILY_LIMIT=400
